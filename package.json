{
  "name": "doce-pe-peknin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "playwright test",
    "verify": "npm run check && npm test && npm run build",
    "export:preview": "npm run build && node scripts/export-preview.mjs",
    "build:pages": "DEPLOY_BASE=/projetos/ DEPLOY_SITE=https://ospozoc.github.io npm run build -- --outDir ../doce-pe-pages-dist"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "7.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
